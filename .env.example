# Environment
NODE_ENV=development
PORT=5000

# Database (PostgreSQL 16+)
DATABASE_URL="postgresql://postgres:password@localhost:5432/silwasa_cms?schema=public"
DIRECT_DATABASE_URL="postgresql://postgres:password@localhost:5432/silwasa_cms?schema=public"

# Frontend Application (Next.js 15)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:5000/api/v1"

# CORS & Routing
FRONTEND_URL="http://localhost:3000"
API_URL="http://localhost:5000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://silwasa.com"

# Security & Sessions
SESSION_SECRET="development-super-secret-session-key-change-in-production-min32chars"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
JWT_SECRET="development-super-secret-jwt-key-change-in-production-min32chars"
JWT_EXPIRES_IN="7d"

# Media Storage (local | cloudinary | s3)
STORAGE_PROVIDER="local"
MEDIA_UPLOAD_DIR="./uploads"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email Integration (mock | brevo | sendgrid | gmail)
EMAIL_PROVIDER="mock"
BREVO_API_KEY=""
SENDGRID_API_KEY=""
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
EMAIL_FROM="contact@silwasa.com"
EMAIL_FROM_NAME="Silwasa IT Solutions"
ADMIN_NOTIFICATION_EMAIL="contact@silwasa.com"
