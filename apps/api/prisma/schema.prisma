datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  SEO_MANAGER
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String
  role         UserRole      @default(ADMIN)
  avatarUrl    String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     Session[]
  blogPosts    BlogPost[]
  enquiries    Enquiry[]     @relation("AssignedAdmin")
  activityLogs ActivityLog[]
  pageRevisions PageRevision[]

  @@index([email])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model Page {
  id              String         @id @default(uuid())
  title           String
  slug            String         @unique
  content         String?
  sections        Json           @default("[]")
  isPublished     Boolean        @default(false)
  publishedAt     DateTime?
  featuredImageId String?
  featuredImageUrl String?
  parentPageId    String?
  parentPage      Page?          @relation("PageHierarchy", fields: [parentPageId], references: [id])
  childPages      Page[]         @relation("PageHierarchy")
  revisions       PageRevision[]
  seo             SEOMetadata?   @relation("PageSEO")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([slug])
  @@index([isPublished])
}

model PageRevision {
  id          String   @id @default(uuid())
  pageId      String
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  title       String
  sections    Json
  version     Int      @default(1)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([pageId])
}

model Menu {
  id        String   @id @default(uuid())
  name      String
  location  String   @unique
  items     Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([location])
}

model BlogPost {
  id                 String             @id @default(uuid())
  title              String
  slug               String             @unique
  excerpt            String
  content            String
  featuredImageUrl   String?
  readingTimeMinutes Int                @default(5)
  isPublished        Boolean            @default(false)
  publishedAt        DateTime?
  authorId           String
  author             User               @relation(fields: [authorId], references: [id])
  categories         PostCategory[]
  tags               PostTag[]
  seo                SEOMetadata?       @relation("BlogPostSEO")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([slug])
  @@index([isPublished])
}

model BlogCategory {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  description String?
  imageUrl    String?
  posts       PostCategory[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([slug])
}

model BlogTag {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  posts     PostTag[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([slug])
}

model PostCategory {
  postId     String
  categoryId String
  post       BlogPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
}

model PostTag {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model Service {
  id               String           @id @default(uuid())
  title            String
  slug             String           @unique
  shortDescription String
  fullDescription  String
  icon             String?
  featuredImageUrl String?
  features         Json             @default("[]")
  benefits         Json             @default("[]")
  process          Json             @default("[]")
  faqs             Json             @default("[]")
  isPublished      Boolean          @default(true)
  order            Int              @default(0)
  pricingPackages  PricingPackage[]
  seo              SEOMetadata?     @relation("ServiceSEO")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([slug])
  @@index([isPublished])
}

model PricingPackage {
  id                String    @id @default(uuid())
  name              String
  serviceId         String?
  service           Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  shortDescription  String
  regularPrice      Decimal   @db.Decimal(10, 2)
  discountedPrice   Decimal?  @db.Decimal(10, 2)
  discountType      String?
  discountValue     Decimal?  @db.Decimal(10, 2)
  discountStartDate DateTime?
  discountEndDate   DateTime?
  currency          String    @default("INR")
  features          Json      @default("[]")
  isPopular         Boolean   @default(false)
  ctaLabel          String    @default("Get Started")
  ctaUrl            String    @default("/contact")
  order             Int       @default(0)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([isActive])
  @@index([serviceId])
}

model Industry {
  id               String       @id @default(uuid())
  name             String
  slug             String       @unique
  shortDescription String
  fullDescription  String
  icon             String?
  featuredImageUrl String?
  challenges       Json         @default("[]")
  solutions        Json         @default("[]")
  isPublished      Boolean      @default(true)
  order            Int          @default(0)
  seo              SEOMetadata? @relation("IndustrySEO")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([slug])
  @@index([isPublished])
}

model PortfolioProject {
  id               String       @id @default(uuid())
  title            String
  slug             String       @unique
  clientName       String
  industry         String
  category         String
  projectUrl       String?
  featuredImageUrl String
  galleryImages    Json         @default("[]")
  description      String
  technologies     Json         @default("[]")
  challenges       String
  solutions        String
  results          String
  isPublished      Boolean      @default(true)
  order            Int          @default(0)
  seo              SEOMetadata? @relation("PortfolioSEO")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([slug])
  @@index([isPublished])
}

model Testimonial {
  id              String   @id @default(uuid())
  clientName      String
  clientRole      String
  clientCompany   String
  clientAvatarUrl String?
  content         String
  rating          Int      @default(5)
  isFeatured      Boolean  @default(false)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isFeatured])
}

model FAQItem {
  id          String   @id @default(uuid())
  question    String
  answer      String
  category    String   @default("General")
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
}

model Enquiry {
  id             String        @id @default(uuid())
  enquiryId      String        @unique
  name           String
  email          String
  phone          String?
  company        String?
  country        String?
  service        String?
  budget         String?
  message        String
  sourcePage     String?
  status         String        @default("NEW")
  assignedUserId String?
  assignedUser   User?         @relation("AssignedAdmin", fields: [assignedUserId], references: [id])
  notes          EnquiryNote[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([email])
}

model EnquiryNote {
  id         String   @id @default(uuid())
  enquiryId  String
  enquiry    Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  userId     String?
  authorName String
  content    String
  createdAt  DateTime @default(now())

  @@index([enquiryId])
}

model MediaItem {
  id           String   @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  url          String
  publicId     String?
  altText      String?
  title        String?
  provider     String   @default("local")
  usageCount   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([provider])
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@index([key])
}

model SEOMetadata {
  id                 String            @id @default(uuid())
  metaTitle          String?
  metaDescription    String?
  metaKeywords       String?
  canonicalUrl       String?
  robotsIndex        Boolean           @default(true)
  robotsFollow       Boolean           @default(true)
  ogTitle            String?
  ogDescription      String?
  ogImageUrl         String?
  twitterCard        String            @default("summary_large_image")
  structuredDataJson String?
  pageId             String?           @unique
  page               Page?             @relation("PageSEO", fields: [pageId], references: [id], onDelete: Cascade)
  blogPostId         String?           @unique
  blogPost           BlogPost?         @relation("BlogPostSEO", fields: [blogPostId], references: [id], onDelete: Cascade)
  serviceId          String?           @unique
  service            Service?          @relation("ServiceSEO", fields: [serviceId], references: [id], onDelete: Cascade)
  industryId         String?           @unique
  industry           Industry?         @relation("IndustrySEO", fields: [industryId], references: [id], onDelete: Cascade)
  portfolioId        String?           @unique
  portfolio          PortfolioProject? @relation("PortfolioSEO", fields: [portfolioId], references: [id], onDelete: Cascade)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName  String
  action    String
  module    String
  entityId  String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([createdAt])
}

model EmailProviderSetting {
  id         String   @id @default(uuid())
  provider   String   @unique
  senderName String
  senderEmail String
  replyTo    String?
  apiKey     String?
  isActive   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model EmailDeliveryLog {
  id        String   @id @default(uuid())
  recipient String
  subject   String
  provider  String
  status    String
  error     String?
  createdAt DateTime @default(now())

  @@index([status])
}
